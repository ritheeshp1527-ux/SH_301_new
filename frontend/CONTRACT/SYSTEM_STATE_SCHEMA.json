    "Emergency": {
      "properties": {
        "emergency_active_state": {
          "default": false,
          "title": "Emergency Active State",
          "type": "boolean"
        },
        "emergency_limit": {
          "minimum": 0.0,
          "title": "Emergency Limit",
          "type": "number"
