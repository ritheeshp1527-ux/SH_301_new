          "type": "string"
        },
        "time_of_day": {
          "default": "Morning",
          "title": "Time Of Day",
          "type": "string"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Grid": {
      "properties": {
        "configured_limit": {
          "minimum": 0.0,
          "title": "Configured Limit",
          "type": "number"
        },
        "active_limit": {
          "minimum": 0.0,
          "title": "Active Limit",
          "type": "number"
        },
        "grid_import": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Grid Import",
          "type": "number"
