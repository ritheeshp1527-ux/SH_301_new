          "type": "number"
        },
        "estimated_completion": {
          "default": 0.0,
          "title": "Estimated Completion",
          "type": "number"
        },
        "estimated_soc_at_departure": {
          "default": 0.0,
          "title": "Estimated Soc At Departure",
          "type": "number"
        },
        "deadline_status": {
          "default": "ON_TRACK",
          "title": "Deadline Status",
          "type": "string"
        },
        "physical_feasibility": {
          "default": true,
          "title": "Physical Feasibility",
          "type": "boolean"
        },
        "current_allocation_feasibility": {
          "default": true,
          "title": "Current Allocation Feasibility",
          "type": "boolean"
        },
        "a3_risk": {
          "default": "NONE",
          "title": "A3 Risk",
          "type": "string"
        },
        "a2_reason": {
          "default": "INIT",
          "title": "A2 Reason",
          "type": "string"
        },
        "grid_contribution": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Grid Contribution",
          "type": "number"
        },
        "solar_contribution": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Solar Contribution",
          "type": "number"
        },
        "station_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Station Id"
        }
      },
      "required": [
        "ev_id",
        "vehicle_type",
        "battery_capacity",
        "current_soc",
        "target_soc",
        "arrival",
        "departure",
        "maximum_rate"
      ],
      "title": "EV",
      "type": "object"
