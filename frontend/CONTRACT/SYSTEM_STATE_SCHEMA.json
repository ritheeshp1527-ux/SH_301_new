{
  "$defs": {
    "Alert": {
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AlertCategory"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "type",
        "message",
        "timestamp",
        "severity"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertCategory": {
      "enum": [
        "A3_PREDICTIVE_RISK",
        "EMERGENCY_EVENT",
        "SAFETY_EVENT"
      ],
      "title": "AlertCategory",
      "type": "string"
    },
    "Allocation": {
      "properties": {
        "ev_id": {
          "title": "Ev Id",
          "type": "string"
        },
        "allocated_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Allocated Rate",
          "type": "number"
        },
        "allocation_status": {
          "default": "PENDING",
          "title": "Allocation Status",
          "type": "string"
        },
        "grid_contribution": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Grid Contribution",
          "type": "number"
        },
        "solar_contribution": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Solar Contribution",
          "type": "number"
        }
      },
      "required": [
        "ev_id"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "Building": {
      "properties": {
        "ac_demand": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Ac Demand",
          "type": "number"
        },
        "lights_demand": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Lights Demand",
          "type": "number"
        },
        "lifts_demand": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Lifts Demand",
          "type": "number"
        },
        "appliances_demand": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Appliances Demand",
          "type": "number"
        },
        "total_building_demand": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Total Building Demand",
          "type": "number"
        }
      },
      "title": "Building",
      "type": "object"
    },
    "EV": {
      "properties": {
        "ev_id": {
          "title": "Ev Id",
          "type": "string"
        },
        "vehicle_type": {
          "title": "Vehicle Type",
          "type": "string"
        },
        "battery_capacity": {
          "exclusiveMinimum": 0.0,
          "title": "Battery Capacity",
          "type": "number"
