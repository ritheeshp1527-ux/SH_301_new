          "type": "boolean"
        },
        "timestep": {
          "default": 1.0,
          "title": "Timestep",
          "type": "number"
        }
      },
      "title": "Simulation",
      "type": "object"
    },
    "Solar": {
      "properties": {
        "generation": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Generation",
          "type": "number"
        },
        "usable_solar": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Usable Solar",
          "type": "number"
        },
        "excess_solar": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Excess Solar",
          "type": "number"
        }
      },
      "title": "Solar",
      "type": "object"
    },
    "Station": {
      "properties": {
        "station_id": {
          "title": "Station Id",
          "type": "string"
        },
        "occupancy": {
          "default": false,
          "title": "Occupancy",
          "type": "boolean"
        },
        "connected_ev_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connected Ev Id"
        },
        "capacity": {
          "exclusiveMinimum": 0.0,
          "title": "Capacity",
          "type": "number"
        },
        "minimum_charging_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Minimum Charging Rate",
          "type": "number"
        },
        "maximum_charging_rate": {
          "minimum": 0.0,
          "title": "Maximum Charging Rate",
          "type": "number"
        },
        "allocated_power": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Allocated Power",
          "type": "number"
        },
        "status": {
          "default": "AVAILABLE",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "capacity",
        "maximum_charging_rate"
      ],
      "title": "Station",
      "type": "object"
    },
    "Strategy": {
      "properties": {
        "active_strategy": {
          "$ref": "#/$defs/StrategyType",
          "default": "DEADLINE_FIRST"
        }
      },
      "title": "Strategy",
      "type": "object"
    },
    "StrategyType": {
      "enum": [
        "DEADLINE_FIRST",
        "SOLAR_FIRST",
        "GRID_SAFETY_FIRST"
      ],
      "title": "StrategyType",
      "type": "string"
    }
  },
  "properties": {
    "simulation": {
      "$ref": "#/$defs/Simulation"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "grid": {
      "$ref": "#/$defs/Grid"
    },
    "building": {
      "$ref": "#/$defs/Building"
    },
    "solar": {
      "$ref": "#/$defs/Solar"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "title": "Stations",
      "type": "array"
    },
    "evs": {
      "items": {
        "$ref": "#/$defs/EV"
      },
      "title": "Evs",
      "type": "array"
    },
    "allocations": {
      "items": {
        "$ref": "#/$defs/Allocation"
      },
      "title": "Allocations",
      "type": "array"
    },
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "strategy": {
      "$ref": "#/$defs/Strategy"
    },
    "emergency": {
      "$ref": "#/$defs/Emergency"
    }
  },
  "required": [
    "grid",
    "emergency"
  ],
  "title": "SystemState",
  "type": "object"
}