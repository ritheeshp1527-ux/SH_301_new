        "arrival": {
          "title": "Arrival",
          "type": "number"
        },
        "departure": {
          "title": "Departure",
          "type": "number"
        },
        "minimum_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Minimum Rate",
          "type": "number"
        },
        "maximum_rate": {
          "minimum": 0.0,
          "title": "Maximum Rate",
          "type": "number"
        },
        "current_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Current Rate",
          "type": "number"
        },
        "energy_required": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Energy Required",
          "type": "number"
        },
        "time_remaining": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Time Remaining",
          "type": "number"
